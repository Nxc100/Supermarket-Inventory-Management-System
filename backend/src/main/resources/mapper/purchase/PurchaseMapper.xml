<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.supermarket.inventory.purchase.mapper.PurchaseMapper">
 <sql id="columns">o.id,o.order_no,o.supplier_id,o.supplier_name,o.supplier_contact,o.supplier_phone,o.supplier_address,o.operator_id,o.operator_name,o.status,o.total_qty,o.total_received_qty,o.total_amount,o.expected_arrival_date,o.arrived_at,o.first_submitted_at,o.submitted_at,o.reviewed_by,o.reviewer_name,o.reviewed_at,o.rejection_reason,o.stocked_at,o.closed_by,o.closed_at,o.close_reason,o.reversed_by,o.reversed_at,o.reverse_reason,o.reconcile_status,o.external_total_amount,o.reconcile_reference,o.reconcile_difference,o.reconcile_resolution,o.reconciled_by,o.reconciled_at,o.reconcile_version,o.remark,o.row_version,o.created_at,o.updated_at</sql>
 <sql id="scope">AND (#{scope.admin} OR o.operator_id=#{scope.userId})</sql>
 <sql id="filters"><where>
 <include refid="scope"/>
 <if test="query.keyword != ''">AND (CONVERT(o.order_no USING utf8mb4) LIKE CONCAT('%',#{query.keyword},'%') OR o.supplier_name LIKE CONCAT('%',#{query.keyword},'%'))</if>
 <if test="query.supplierId != null">AND o.supplier_id=#{query.supplierId}</if>
 <if test="query.status != null">AND o.status=#{query.status}</if>
 <if test="query.reconcileStatus != null">AND o.reconcile_status=#{query.reconcileStatus}</if>
 <choose><when test="query.dateBasis.name() == 'EVENT'">AND EXISTS(SELECT 1 FROM v_purchase_event e WHERE e.purchase_id=o.id <if test="query.startDate != null">AND e.event_at &gt;= #{query.startDate}</if><if test="query.endDate != null">AND e.event_at &lt; DATE_ADD(#{query.endDate},INTERVAL 1 DAY)</if>)</when><when test="query.dateBasis.name() == 'STOCKED'"><if test="query.startDate != null">AND o.stocked_at &gt;= #{query.startDate}</if><if test="query.endDate != null">AND o.stocked_at &lt; DATE_ADD(#{query.endDate},INTERVAL 1 DAY)</if></when>
 <otherwise><if test="query.startDate != null">AND o.created_at &gt;= #{query.startDate}</if><if test="query.endDate != null">AND o.created_at &lt; DATE_ADD(#{query.endDate},INTERVAL 1 DAY)</if></otherwise></choose>
 </where></sql>
 <select id="find" resultType="com.supermarket.inventory.purchase.entity.PurchaseOrder">SELECT <include refid="columns"/> FROM purchase_order o WHERE o.id=#{id} <include refid="scope"/></select>
 <select id="lock" resultType="com.supermarket.inventory.purchase.entity.PurchaseOrder">SELECT <include refid="columns"/> FROM purchase_order o WHERE o.id=#{id} <include refid="scope"/> FOR UPDATE</select>
 <select id="page" resultType="com.supermarket.inventory.purchase.entity.PurchaseOrder">SELECT <include refid="columns"/> FROM purchase_order o <include refid="filters"/> ORDER BY o.created_at DESC,o.id DESC LIMIT #{query.pageSize} OFFSET #{query.offset}</select>
 <select id="count" resultType="long">SELECT COUNT(*) FROM purchase_order o <include refid="filters"/></select>
 <select id="items" resultType="com.supermarket.inventory.purchase.entity.PurchaseItem">SELECT id,purchase_id,line_no,product_id,product_code,product_barcode,product_name,category_id,category_name,specification,unit,manages_expiry,quantity,received_qty,unit_cost,line_amount,supplier_batch_no,production_date,expiry_date,batch_no,stock_qty,external_qty,external_unit_cost,external_line_amount,reconcile_note FROM purchase_item WHERE purchase_id=#{purchaseId} ORDER BY line_no</select>
 <insert id="create" useGeneratedKeys="true" keyProperty="id">INSERT INTO purchase_order(order_no,supplier_id,supplier_name,supplier_contact,supplier_phone,supplier_address,operator_id,operator_name,total_qty,total_received_qty,total_amount,expected_arrival_date,arrived_at,remark,created_at,updated_at) VALUES(#{orderNo},#{supplierId},#{supplierName},#{supplierContact},#{supplierPhone},#{supplierAddress},#{operatorId},#{operatorName},#{totalQty},#{totalReceivedQty},#{totalAmount},#{expectedArrivalDate},#{arrivedAt},#{remark},#{now},#{now})</insert>
 <update id="update">UPDATE purchase_order SET supplier_id=#{supplierId},supplier_name=#{supplierName},supplier_contact=#{supplierContact},supplier_phone=#{supplierPhone},supplier_address=#{supplierAddress},total_qty=#{totalQty},total_received_qty=#{totalReceivedQty},total_amount=#{totalAmount},expected_arrival_date=#{expectedArrivalDate},arrived_at=#{arrivedAt},remark=#{remark},row_version=row_version+1 WHERE id=#{id}</update>
 <insert id="insertItems">INSERT INTO purchase_item(purchase_id,line_no,product_id,product_code,product_barcode,product_name,category_id,category_name,specification,unit,manages_expiry,quantity,received_qty,unit_cost,supplier_batch_no,production_date,expiry_date,created_at) VALUES
 <foreach collection="items" item="i" separator=",">(#{purchaseId},#{i.lineNo},#{i.productId},#{i.productCode},#{i.productBarcode},#{i.productName},#{i.categoryId},#{i.categoryName},#{i.specification},#{i.unit},#{i.managesExpiry},#{i.quantity},#{i.receivedQty},#{i.unitCost},#{i.supplierBatchNo},#{i.productionDate},#{i.expiryDate},#{now})</foreach></insert>
 <select id="categoryNames" resultType="com.supermarket.inventory.purchase.entity.CategoryName">SELECT id,name FROM category WHERE id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach></select>
 <select id="reconcileHistory" resultType="com.supermarket.inventory.purchase.entity.ReconcileHistoryRow">SELECT id,actor_name,action,reason,CAST(before_data AS CHAR) before_json,CAST(after_data AS CHAR) after_json,occurred_at FROM operation_log WHERE target_type='PURCHASE' AND target_id=#{id} AND action IN ('RECONCILE_DIFFERENCE','RECONCILE_MATCH','RECONCILE_WITHDRAW') ORDER BY occurred_at DESC,id DESC</select>
</mapper>

